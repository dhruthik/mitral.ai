# Backend: your Mistral API key.
# Get one at https://console.mistral.ai → API Keys → Create new key.
# The free tier is enough for this; keys look like a ~32-char string.
MISTRAL_API_KEY=

# Dev mode: serve the prewritten panel in mitral/fixture.py instead of calling
# Mistral. Instant and free, same response shape, but the panel is always the
# same eight people talking about a night cafe. Set to 0 for real generation.
DEV_MODE=1

# Which origin the browser app is served from (CORS allowlist).
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (optional; defaults to http://localhost:8000).
VITE_API_URL=http://localhost:8000
