# Backend: your Mistral API key.
# Get one at https://console.mistral.ai → API Keys → Create new key.
# The free tier is enough for this; keys look like a ~32-char string.
MISTRAL_API_KEY=

# Which origin the browser app is served from (CORS allowlist).
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (optional; defaults to http://localhost:8000).
VITE_API_URL=http://localhost:8000
